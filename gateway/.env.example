# Gateway environment placeholders
# Fill this file only on the target host. Never commit a populated copy.
EXPECTED_HOSTNAME=login.example.com
PUBLIC_ORIGIN=https://login.example.com
AUTH_USERNAME=replace-with-local-admin-name
AUTH_PASSWORD_HASH=replace-with-scrypt-hash:replace-with-salt
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional: integer 300-86400 seconds; defaults to 28800. Invalid values stop startup.
SESSION_TTL_SECONDS=28800
TURNSTILE_SITE_KEY=replace-with-public-site-key
TURNSTILE_SECRET_KEY=replace-with-local-secret-key
PORT=31322
CREDENTIALS_FILE=/var/lib/dsh-login-gateway/credentials.json
AUTH_RATE_PER_MINUTE=30
AUTH_MAX_CONCURRENT=4
